# =====================================================================
#  WHITE-LOTUS — settings reference (local-first)
#
#  You normally don't need this file. The launcher (WHITE-LOTUS.cmd / white-lotus.sh) asks a few questions on
#  first run and saves your answers in your config folder as  settings.env :
#     Windows  %LOCALAPPDATA%\WHITE-LOTUS\config\settings.env
#     macOS    ~/Library/Application Support/WHITE-LOTUS/config/settings.env
#     Linux    ~/.config/white-lotus/settings.env
#  Any line below can go in that file. Real environment variables override it.
#
#  Managed automatically — do NOT set by hand:
#     encryption keys (AUTH_SECRET, ENCRYPTION_KEYS, BLIND_INDEX_KEY, CRON_SECRET) → generated on first run,
#       kept in the config folder (Windows: protected with DPAPI), separate from your data.
#     APP_URL / AUTH_URL → http://127.0.0.1:<port>  (the app listens on this computer only)
#  There is no database server and no cloud storage: everything is in your data folder.
# =====================================================================

# ---- Where your data lives (optional; default shown above, or choose one in Settings → Privacy & storage) ----
# WHITE_LOTUS_DATA_DIR=D:\WHITE-LOTUS-data
# PORT=3000

# ---- Access from your phone / anywhere (set by: npm run local -- remote on) ----
# The app still listens only on 127.0.0.1; Tailscale forwards your own devices to it. See docs/MOBILE-AND-REMOTE.md
# WHITE_LOTUS_PUBLIC_URL=https://my-pc.tail1234.ts.net

# ---- Privacy ----
# true = only AI running on this computer / local network is allowed; web search, URL reading and weather are
# switched off. Nothing leaves this computer.
LOCAL_OFFLINE_MODE=false
# Personal install: only one (owner) account can be created.
LOCAL_SINGLE_USER=true

# ---- Footer credit ("Made by …"); compiled in, so the launcher rebuilds when it changes ----
NEXT_PUBLIC_CREATOR_NAME=
# Shown on the Admin / Creator page (defaults: Kamal Kant · Legal Secretary at Remfry & Sagar)
# NEXT_PUBLIC_CREATOR_ROLE=

# ---- AI (choose one). Model ids are "<provider>:<model>". ----
# Fully local (recommended for confidential work): Ollama — https://ollama.com, then `ollama pull llama3.1`
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# DEFAULT_MODEL=ollama:llama3.1
#
# Any OpenAI-compatible server — local (LM Studio, vLLM, llama.cpp) or cloud (Groq, OpenRouter, Together…)
# CUSTOM_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# CUSTOM_OPENAI_API_KEY=
# CUSTOM_OPENAI_NAME=custom
# DEFAULT_MODEL=custom:<model-name>
#
# Cloud APIs (your message, recent conversation and relevant file excerpts are sent to answer):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=
# DEFAULT_MODEL=openai:<model>   |  anthropic:<model>  |  google:<model>
#
# FAST_MODEL=            # titles / query planning (defaults to DEFAULT_MODEL)
# FALLBACK_MODEL=        # used if the main model fails
# ENABLED_MODELS=        # models shown in the picker; flags: |vision |novision |tools |notools |reasoning
# MAX_CONTEXT_TOKENS=24000
# MAX_OUTPUT_TOKENS=4096

# ---- Web research (optional; only search queries are sent) ----
# SEARCH_PROVIDERS=tavily           # tavily | brave | searxng (comma = fallback order)
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SEARXNG_URL=http://127.0.0.1:8080  # self-hosted SearXNG (it still queries public search engines)

# ---- Upload malware scanning (optional; local ClamAV) ----
# MALWARE_SCANNER=clamav            # none | clamav | http
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# MALWARE_SCAN_REQUIRED=false       # true = refuse uploads when the scanner isn't running

# ---- Files ----
# MAX_UPLOAD_SIZE_MB=20
# FILE_RETENTION_DAYS=0             # auto-delete files older than N days (0 = keep)

# ---- Accounts & sessions ----
# SESSION_MAX_AGE_HOURS=168
# SESSION_IDLE_TIMEOUT_MINUTES=720
# RATE_LIMIT_LOGIN_ATTEMPTS=10
# ALLOW_GUEST_CHAT=false            # no-account chats (rarely useful on a personal computer)

# ---- Optional external services (off unless set) ----
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=      # "Continue with Google" (contacts accounts.google.com)
# RESEND_API_KEY= / POSTMARK_SERVER_TOKEN=       # emailed password resets (otherwise: reset-password.cmd)

# ---- Tools ----
# ENABLE_CODE_EXECUTION=false       # sandboxed JavaScript tool (Node vm — not a hard security boundary)
# LOG_LEVEL=info

# =====================================================================
#  ONLINE EDITION (a hosted website — see docs/ONLINE.md). Set these in your host's environment settings.
#  Conversations are stored in users' browsers; the database holds accounts and encrypted sync copies only.
# =====================================================================
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require   # e.g. Neon (free tier)
# AUTH_SECRET=                     # long random string; never change it (other keys are derived from it)
# OWNER_SETUP_CODE=                # one-time code to create the owner account; delete afterwards
# AUTH_ALLOW_SIGNUP=true
# WEB_GUEST_DAILY_MESSAGES=30      # "Use without account" limits, per network per day
# WEB_GUEST_DAILY_SEARCHES=5
# WEB_VAULT_MAX_MB=50              # encrypted sync storage per account
