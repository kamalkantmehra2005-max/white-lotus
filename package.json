{
  "name": "white-lotus",
  "version": "1.0.0",
  "private": true,
  "description": "WHITE-LOTUS — your intelligent AI workspace",
  "scripts": {
    "local": "tsx --conditions=react-server scripts/local/cli.ts",
    "start": "tsx --conditions=react-server scripts/local/cli.ts start",
    "dev": "tsx --conditions=react-server scripts/local/cli.ts dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate && tsx scripts/db/embed-migrations.ts",
    "cloud:migrate": "tsx scripts/cloud/migrate.ts",
    "cloud:build": "next build",
    "db:embed": "tsx scripts/db/embed-migrations.ts",
    "pack:github": "tsx scripts/pack-github-upload.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@electric-sql/pglite": "^0.5.8",
    "@node-rs/argon2": "^2.2.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "highlight.js": "^11.10.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "next": "^16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.4",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5",
    "undici": "^7.30.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": "22.x"
  }
}
